{
  "partition": "gpu-rtx6000",
  "time": "3:00:00",
  "gres": null,
  "gpus": 1,
  "nodes": 1,
  "ntasks_per_node": 1,
  "cpus_per_task": 4,
  "mem": "64G",
  "output_dir": "/home/%u/umich-slm/slurm-logs",
  "output_pattern": "scaling-%j.out",
  "account": "<account>",
  "qos": null,
  "mail_account": "user",
  "mail_type": "END,FAIL",
  "conda_env": "umich-slm",
  "modules": [],
  "env_vars": {
    "HF_HOME": "/path/to/data",
    "TOKENIZERS_PARALLELISM": "false"
  },
  "host_env": {
    "lackerli": [
      "export CUDA_HOME=/usr/local/cuda-12.6",
      "export PATH=/usr/local/cuda-12.6/bin:/opt/anaconda/bin:/usr/sbin:/usr/bin:/sbin:/bin",
      "export LD_LIBRARY_PATH=/usr/local/cuda-12.6/lib64",
      "export TORCH_CUDA_ARCH_LIST=\"8.0\""
    ],
    "sushi": [
      "export NCCL_ASYNC_ERROR_HANDLING=1",
      "export TORCH_NCCL_BLOCKING_WAIT=1",
      "export NCCL_IB_DISABLE=1",
      "export NCCL_P2P_LEVEL=NVL"
    ]
  },
  "dataset": "fineweb_edu_1B_train",
  "dataset_dir": null,
  "eval_dataset": "fineweb_edu_1B_val",
  "dataset_configs": {},
  "models_output_dir": "/path/to/data"
}